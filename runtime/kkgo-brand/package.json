{
  "name": "@deepseek-ai/dsh-client-ui-brand-kkgo",
  "version": "0.2.2-rc.5",
  "description": "KK Go 品牌插件：接管侧边栏品牌插槽，替换上游 deepseek HARNESS 字样",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
